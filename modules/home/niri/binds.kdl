
binds {
  // App spawning
  Mod+Return hotkey-overlay-title="Open kitty" { spawn "kitty"; }
  Mod+Y hotkey-overlay-title="Open yazi" { spawn "kitty" "-e" "yazi"; }
  Mod+W hotkey-overlay-title="Open Brave" { spawn "brave"; }
  Mod+C { spawn-sh "noctalia msg panel-toggle calendar"; }
  Mod+N { spawn-sh "noctalia msg nightlight-toggle"; }
  // Mod+Space { spawn-sh "fuzzel"; }
  Mod+Shift+R { spawn-sh "pick-window"; }
  Mod+R { spawn-sh "vicinae open"; }
  // Ctrl+L { spawn-sh "wlogout"; }

  // Window manipulation
  Mod+Shift+K { move-window-up-or-to-workspace-up; }
  Mod+Shift+J { move-window-down-or-to-workspace-down; }
  Mod+BracketLeft { consume-or-expel-window-left; }
  Mod+Shift+F { toggle-window-floating; }
  Mod+BracketRight { consume-or-expel-window-right; }
  Mod+Q { close-window; }
  Mod+J { focus-window-or-workspace-down; }
  Mod+K { focus-window-or-workspace-up; }


  // Column manipulation
  Mod+T { toggle-column-tabbed-display; }
  Mod+Shift+1 { move-column-to-workspace 1; }
  Mod+Shift+2 { move-column-to-workspace 2; }
  Mod+Shift+3 { move-column-to-workspace 3; }
  Mod+Shift+4 { move-column-to-workspace 4; }
  Mod+Shift+5 { move-column-to-workspace 5; }
  Mod+Shift+6 { move-column-to-workspace 6; }
  Mod+Shift+7 { move-column-to-workspace 7; }
  Mod+Shift+8 { move-column-to-workspace 8; }
  Mod+Shift+9 { move-column-to-workspace 9; } 

  Mod+Shift+H { move-column-left; }
  Mod+Shift+L { move-column-right; }

  Mod+Shift+S { screenshot-screen; }

  // Workspaces
  Mod+O { toggle-overview; }
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }
  Mod+6 { focus-workspace 6; }
  Mod+7 { focus-workspace 7; }
  Mod+8 { focus-workspace 8; }
  Mod+9 { focus-workspace 9; }
  Mod+H { focus-column-left; }
  Mod+F { maximize-column; }
  Mod+L { focus-column-right; }
   
  Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
  Mod+Shift+Space { spawn-sh "noctalia msg panel-toggle launcher /win"; }
  Mod+E { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
  Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
   
  Mod+Escape { spawn-sh "noctalia msg panel-toggle session"; }
  Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }

  // Audio & Brightness
  // XF86AudioRaiseVolume { spawn "noctalia" "ipc" "call" "volume" "increase"; }
  // XF86AudioLowerVolume { spawn "noctalia" "ipc" "call" "volume" "decrease"; }
  // XF86AudioMute { spawn "noctalia" "ipc" "call" "volume" "muteOutput"; }
  // XF86MonBrightnessUp { spawn "noctalia" "ipc" "call" "brightness" "increase"; }
  // XF86MonBrightnessDown { spawn "noctalia" "ipc" "call" "brightness" "decrease"; }

  // Audio, brightness, and media control
  XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

  XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
  XF86MonBrightnessUp { spawn "brightnessctl" "set" "5%+"; }

  XF86AudioPlay { spawn "playerctl" "play-pause"; }
  XF86AudioPause { spawn "playerctl" "play-pause"; }
  XF86AudioNext { spawn "playerctl" "next"; }
}
